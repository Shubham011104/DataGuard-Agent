# =============================================================================
# DataGuard Agent — Environment Variables Template
# Copy this file to '.env' and fill in your keys:
#   cp .env.example .env
# =============================================================================

# ── LLM Provider Configuration ───────────────────────────────────────────────
# Options: "Groq (Free)", "OpenRouter (Free)", "Ollama (Free Local)", "OpenAI"
LLM_PROVIDER=Groq (Free)

# 100% FREE Provider Keys (Get free keys: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_free_groq_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_free_openrouter_key_here

# OpenAI Key (Paid)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Local Ollama (Free & Offline)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Default Model Selection
# For Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
# For OpenRouter: meta-llama/llama-3.1-8b-instruct:free
# For OpenAI: gpt-4o-mini, gpt-4o
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048

# ── Database Connection ───────────────────────────────────────────────────────
# Default: Local SQLite database stored in dataguard.db
# For PostgreSQL: postgresql://user:password@localhost:5432/dataguard_db
DATABASE_URL=sqlite:///dataguard.db

# ── Data Quality Anomaly Thresholds ──────────────────────────────────────────
NULL_RATE_THRESHOLD=0.05       # Flag columns with > 5% missing values
ZSCORE_THRESHOLD=3.0           # Flag numeric values exceeding ±3 standard deviations
IQR_MULTIPLIER=1.5             # Flag values outside Tukey fence [Q1 - 1.5*IQR, Q3 + 1.5*IQR]

# ── Agent Execution Settings ─────────────────────────────────────────────────
MAX_CORRECTION_ATTEMPTS=3      # Max retries on SQL syntax error self-correction
AGENT_VERBOSE=true             # Print detailed step logs in console
